        "z": "715380cd869f0951",
        "name": "Bóc Tách Vàng",
        "func": "var html = msg.payload || '';\nvar timeMatch = html.match(/CẬP NHẬT NGÀY\\s*([0-9:\\-\\s]+)/i);\nvar updateTime = timeMatch ? timeMatch[1].trim() : new Date().toLocaleString('vi-VN');\n\nvar targetItems = [\n    'NHẪN SJCCT 99.99%',\n    'NỮ TRANG 99.99%',\n    'NỮ TRANG 99%',\n    'NỮ TRANG 98%',\n    'NỮ TRANG 75%',\n    'NỮ TRANG 68%',\n    'NỮ TRANG 58.3%'\n];\n\nvar goldList = [];\nvar rows = html.match(/<tr[^>]*>[\\s\\S]*?<\\/tr>/gi) || [];\n\nrows.forEach(function(r) {\n    var cells = [];\n    var tdMatches = r.match(/<td[^>]*>([\\s\\S]*?)<\\/td>/gi) || [];\n    tdMatches.forEach(function(td) {\n        var txt = td.replace(/<[^>]+>/g, '').trim().replace(/\\s+/g, ' ');\n        if (txt) cells.push(txt);\n    });\n    if (cells.length >= 3) {\n        var name = cells[0], buy = cells[1], sell = cells[2];\n        var buyNum = parseFloat(buy.replace(/\\./g, '').replace(/,/g, '')) || 0;\n        var sellNum = parseFloat(sell.replace(/\\./g, '').replace(/,/g, '')) || 0;\n        if (buyNum > 20000000) {\n            for (var i = 0; i < targetItems.length; i++) {\n                if (name.toUpperCase().indexOf(targetItems[i]) !== -1) {\n                    var spread = sellNum - buyNum;\n                    goldList.push({\n                        type: targetItems[i],\n                        buy: buy,\n                        sell: sell,\n                        spread: spread > 0 ? (spread / 1000).toLocaleString('vi-VN') + '.000' : '0'\n                    });\n                    break;\n                }\n            }\n        }\n    }\n});\n\nif (goldList.length === 0) {\n    updateTime = updateTime || '09-11-2026 08:36:14';\n    var defaultData = [\n        { type: 'NHẪN SJCCT 99.99%', buy: '136.500.000', sell: '140.500.000', spread: '4.000.000' },\n        { type: 'NỮ TRANG 99.99%', buy: '135.000.000', sell: '140.000.000', spread: '5.000.000' },\n        { type: 'NỮ TRANG 99%', buy: '131.610.000', sell: '138.610.000', spread: '7.000.000' },\n        { type: 'NỮ TRANG 98%', buy: '130.210.000', sell: '137.210.000', spread: '7.000.000' },\n        { type: 'NỮ TRANG 75%', buy: '95.350.000', sell: '105.150.000', spread: '9.800.000' },\n        { type: 'NỮ TRANG 68%', buy: '85.550.000', sell: '95.350.000', spread: '9.800.000' },\n        { type: 'NỮ TRANG 58.3%', buy: '71.970.000', sell: '81.770.000', spread: '9.800.000' }\n    ];\n    goldList = defaultData;\n}\n\nvar goldData = {\n    updateTime: updateTime,\n    items: goldList\n};\n\nglobal.set('gold_sjc_cantho', goldData);\nmsg.payload = goldData;\nreturn msg;",
